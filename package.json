{
  "name": "aria",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev --filter=edubridge --filter=@repo/agent --filter=@repo/ui --filter=@repo/ai-ui",
    "dev:all": "turbo run dev",
    "dev:edubridge": "turbo run dev --filter=edubridge --filter=@repo/ui --filter=@repo/ai-ui",
    "dev:web": "turbo run dev --filter=web --filter=@repo/ui --filter=@repo/ai-ui",
    "dev:docs": "turbo run dev --filter=docs --filter=@repo/ui",
    "dev:agent": "turbo run dev --filter=@repo/agent",
    "dev:edubridge+agent": "turbo run dev --filter=edubridge --filter=@repo/agent --filter=@repo/ui --filter=@repo/ai-ui",
    "dev:web+agent": "turbo run dev --filter=web --filter=@repo/agent --filter=@repo/ui --filter=@repo/ai-ui",
    "build": "turbo run build",
    "build:edubridge": "turbo run build --filter=edubridge...",
    "build:web": "turbo run build --filter=web...",
    "build:docs": "turbo run build --filter=docs...",
    "build:ui": "turbo run build --filter=@repo/ui",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:check": "pnpm --filter @repo/db db:check",
    "db:push": "pnpm --filter @repo/db db:push",
    "seed:dev": "pnpm --filter @repo/db seed:dev",
    "start:edubridge": "pnpm --filter edubridge start",
    "start:web": "pnpm --filter web start",
    "start:docs": "pnpm --filter docs start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "clean:cache": "rimraf .turbo && rimraf apps/edubridge/.next apps/web/.next apps/docs/.next apps/agent/.mastra packages/ui/dist node_modules/.cache",
    "clean:turbo": "rimraf .turbo && rimraf apps/**/.turbo && rimraf packages/**/.turbo",
    "ui:add": "pnpm dlx shadcn@latest add -c ./packages/ui",
    "registry:add": "pnpm dlx shadcn@latest add -c ./apps/edubridge",
    "canvas:preview": "node ./scripts/open-marketing-canvas.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0"
  }
}
