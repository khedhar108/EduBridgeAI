# ── Required: app queries + seed (transaction pooler, port 6543) ──────────────
# Same value must also live in apps/edubridge/.env.local for Next.js.
# Replace [YOUR-PASSWORD]; URL-encode special chars (@ → %40).
DATABASE_URL="postgresql://postgres.xzqxehyjkftzkllmgcwq:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ── Optional: drizzle-kit only (session pooler, port 5432) ──────────────────
