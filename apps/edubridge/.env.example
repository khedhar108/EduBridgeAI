# NODE_ENV — omit on every host. Next.js sets it from the command:
#   pnpm dev → development | Vercel/Coolify next build → production
# Do not put NODE_ENV in this file, .env.local, Vercel, or Coolify.
# Never NODE_ENV=staging (use APP_ENV=staging for hostname routing).
#
# APP_ENV — routing / hostname only (not a substitute for NODE_ENV):
# local: omit or APP_ENV=local | Vercel: APP_ENV=staging | Coolify: APP_ENV=production
APP_ENV=local
# WORKSPACE_ROOT_DOMAIN=edubridge.app

# Mastra agent (apps/agent). localhost fallback is local-development only.
MASTRA_API_URL=http://localhost:4111

# Supabase Auth (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xzqxehyjkftzkllmgcwq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6cXhlaHlqa2Z0emtsbG1nY3dxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMjE1NjksImV4cCI6MjEwMTU5NzU2OX0.ZtsZOJFQK-RpJFXHsKdkm3tH9amgifeCA6sXl99oXW0

# Same DATABASE_URL as packages/db/.env (:6543 transaction pooler).
# Next.js only reads this file — it does not load packages/db/.env.
# DATABASE_URL="postgresql://postgres.xzqxehyjkftzkllmgcwq:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Public apex origin for auth email redirects (never a school subdomain).
# Vercel staging: https://dev.edubridge.app
# Coolify prod:   https://edubridge.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# FAMILY_SESSION_SECRET=
